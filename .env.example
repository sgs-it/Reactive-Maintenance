# For compose.yaml only, generate a random hex password for local PostgreSQL.
POSTGRES_PASSWORD=
RMCS_DOMAIN=
# Optional until the CompanyCam pilot is ready.
COMPANYCAM_KEY=
# For compose.supabase.yaml or running Node directly, set DATABASE_URL here.
# Use a Supabase PostgreSQL connection string with sslmode=verify-full on the host.
DATABASE_URL=
# Use the Project URL and publishable key from the same Supabase project.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Optional, server only. Enables creating Supabase sign-in credentials from User Accounts.
SUPABASE_SECRET_KEY=
# RMCS_AUTH_MODE defaults to supabase. Set local only for a standalone PostgreSQL deployment.
# For a Supabase database provisioned with deploy/supabase-runtime.sql:
# RMCS_DATABASE_MANAGED=true
